# Playwright E2E Test Credentials (Template)
# Copy this file to .env.test and fill in your test account details.

# Manager (PRO plan)
TEST_MANAGER_EMAIL=
TEST_MANAGER_PASSWORD=

# Tenant
TEST_TENANT_EMAIL=
TEST_TENANT_PASSWORD=

# Admin (Super Admin)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_ADMIN_SECURITY_KEY=

# API base URL (Fastify backend)
TEST_API_URL=http://localhost:3001
