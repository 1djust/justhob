{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/.turbo/**": true,
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/.gradle/**": true,
    "**/android/.gradle/**": true,
    "**/android/app/build/**": true,
    "**/ios/Pods/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/.turbo": true,
    "**/build": true,
    "**/.dart_tool": true,
    "**/.gradle": true
  },
  "typescript.tsserver.maxTsServerMemory": 3072,
  "typescript.disableAutomaticTypeAcquisition": true,
  "dart.flutterSdkPath": "C:\\src\\flutter",
  "dart.analysisExcludedFolders": [
    "propertystack_mobile/build",
    "propertystack_mobile/android/.gradle"
  ]
}
